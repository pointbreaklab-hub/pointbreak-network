{
  "name": "pointbreak-network",
  "version": "0.1.0",
  "description": "A serverless, Git-backed job network. Math over emotion.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "net": "tsx scripts/net-cli.ts",
    "scenario:attestation": "tsx scripts/attestation-scenario.ts",
    "server": "tsx server/src/node.ts",
    "server:check": "tsc -p server/tsconfig.json",
    "server:dev": "tsx watch server/src/node.ts",
    "keygen": "tsx scripts/keygen.ts"
  },
  "dependencies": {
    "@noble/ed25519": "^2.1.0",
    "dexie": "^4.0.8",
    "pdfjs-dist": "^5.6.205"
  },
  "devDependencies": {
    "@rollup/plugin-yaml": "^4.1.2",
    "@sveltejs/adapter-static": "^3.0.4",
    "@sveltejs/kit": "^2.5.27",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.5.1",
    "js-yaml": "^4.1.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
