# Client-side (safe to expose — these are public identifiers, not secrets)
PUBLIC_GITHUB_CLIENT_ID=
PUBLIC_DATA_REPO=pointbreak-network/data
PUBLIC_RECEIPT_PUBKEY=
PUBLIC_WORKER_URL=https://receipts.pointbreaklab.com

# Worker-only — set via `wrangler secret put`, NEVER commit real values
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RECEIPT_SIGNING_KEY=
# GITHUB_APP_TOKEN=
