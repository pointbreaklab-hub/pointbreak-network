# Client-side (safe to expose, these are public identifiers, not secrets)
PUBLIC_GITHUB_CLIENT_ID=
PUBLIC_DATA_REPO=pointbreaklab-hub/pointbreak-data
PUBLIC_RECEIPT_PUBKEY=
PUBLIC_LEDGER_URL=

# Empty on the apex domain. '/pointbreak-network' when serving from github.io,
# where Pages uses a subpath and every internal link would otherwise 404.
PUBLIC_BASE_PATH=

# 'true' sends events to the ledger service so other people can see them. Off by
# default: with one user a shared ledger computes nothing a local one cannot,
# and turning it on requires a deployed Worker.
PUBLIC_PUBLISH_LEDGER=false

# Worker-only. Set via `the environment file`, NEVER commit real values
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# RECEIPT_SIGNING_KEY=
# GITHUB_APP_TOKEN=
