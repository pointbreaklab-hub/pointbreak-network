# Fine-grained token, scoped to the data repo only, Contents: read and write.
# The only credential that can write the ledger.
GITHUB_TOKEN=

# HMAC key for append tokens and sybil guards. Generate with: npm run keygen
# Rotating it invalidates every outstanding token and every guard.
TOKEN_SIGNING_KEY=

DATA_REPO=pointbreaklab-hub/pointbreak-data

# Set this in production. '*' is fine only for local development.
ALLOWED_ORIGIN=http://localhost:4173

MIN_ACCOUNT_AGE_DAYS=30
MONTHLY_APPEND_BUDGET=60
PORT=8787
STORE_PATH=./data/guard.json
